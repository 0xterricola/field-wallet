class FieldWalletBackend
{
    PROP(bool ready READONLY)
    PROP(QString buildLabel READONLY)

    PROP(QString walletState READONLY)
    PROP(QString configPath READONLY)
    PROP(QString storagePath READONLY)
    PROP(QString recoveryPhrase READONLY)
    PROP(QString savedWalletsJson READONLY)

    PROP(QString accountId READONLY)
    PROP(QString accountKind READONLY)
    PROP(QString balanceRaw READONLY)
    PROP(QString walletError READONLY)
    PROP(QString walletFolderSelection READONLY)
    PROP(bool walletFolderHasConfig READONLY)
    PROP(bool walletFolderHasStorage READONLY)
    PROP(bool walletBusy READONLY)
    PROP(bool walletSwitchBusy READONLY)

    SLOT(QString ping())
    SLOT(void refreshWallet())
    SLOT(void chooseWalletFolder())
    SLOT(void createWallet(QString password, QString sequencerAddr))
    SLOT(void createNamedWallet(QString walletName, QString password, QString sequencerAddr))
    SLOT(void openWallet(QString configPath, QString storagePath))
    SLOT(void switchWallet(QString configPath, QString storagePath))
    SLOT(void renameWallet(QString storagePath, QString displayName))
    SLOT(void clearRecoveryPhrase())
    SLOT(void createPublicAccount())
    SLOT(void createPrivateAccount())
}
